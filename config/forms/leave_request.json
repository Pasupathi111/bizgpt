{
  "id": "leave_request",
  "title": "Leave request",
  "description": "Apply for annual, sick, or other leave.",
  "keywords": ["leave", "vacation", "holiday", "time off", "sick", "pto"],
  "schema": {
    "type": "object",
    "required": ["leave_type", "start_date", "end_date", "reason"],
    "properties": {
      "leave_type": {"type": "string", "title": "Leave type", "enum": ["Annual", "Sick", "Casual", "Parental", "Unpaid"], "default": "Annual"},
      "start_date": {"type": "string", "format": "date", "title": "From"},
      "end_date": {"type": "string", "format": "date", "title": "To"},
      "half_day": {"type": "boolean", "title": "Half day", "default": false},
      "reason": {"type": "string", "title": "Reason", "minLength": 3, "maxLength": 500},
      "handover_to": {"type": "string", "title": "Work handed over to", "maxLength": 100}
    }
  },
  "ui_schema": {
    "ui:order": ["leave_type", "start_date", "end_date", "half_day", "reason", "handover_to"],
    "reason": {"ui:widget": "textarea", "ui:options": {"rows": 2}}
  },
  "action": {"type": "record", "reference_prefix": "LV"},
  "success_message": "{leave_type} leave requested from {start_date} to {end_date}. Reference {reference}; your manager has been notified."
}
