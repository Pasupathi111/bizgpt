# ---- Open WebUI ----
OWUI_VERSION=v0.11.4
OWUI_PORT=3000
OWUI_URL=http://localhost:3000
# Admin → Settings → Account → API keys (after first login). Used by scripts/sync.py
OWUI_API_KEY=sk-xxxxxxxx
WEBUI_SECRET_KEY=change-me

# ---- Dify (your self-hosted server) ----
# Base URL WITHOUT /v1. Must be reachable from inside the Open WebUI container.
DIFY_BASE_URL=https://dify.yourcompany.com
# One entry per Dify app. api_key: Dify → app → "API Access" → API Key (starts with app-)
# type: chatflow | agent | chat | workflow | completion
DIFY_APPS=[{"id":"lead-qualifier","name":"Lead Qualifier","type":"workflow","api_key":"app-xxxx","input_key":"query"},{"id":"hr-assistant","name":"HR Policy Assistant","type":"chatflow","api_key":"app-yyyy"}]
