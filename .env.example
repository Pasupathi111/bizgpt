# ---- Biz GPT (pinned; never "latest") ----
OPEN_WEBUI_VERSION=v0.11.4
OPEN_WEBUI_PORT=3000
OPEN_WEBUI_URL=http://localhost:3000
# Settings → Account → API Keys (admin). Used by scripts/sync.py
OPEN_WEBUI_API_KEY=
WEBUI_SECRET_KEY=change-me-long-random
WEBUI_NAME=Biz GPT
# LLM provider for Biz GPT (pick one)
OLLAMA_BASE_URL=http://host.docker.internal:11434
# OPENAI_API_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=
# Base model behind the "Biz GPT Assistant" workspace model (id as shown in Biz GPT)
BIZGPT_BASE_MODEL=qwen2.5-coder:7b

# ---- Dynamic Forms service ----
FORMS_PORT=8090
# Shared secret between Biz GPT tool and forms service: openssl rand -hex 32
FORMS_API_KEY=change-me
# How Biz GPT (server side) reaches the forms service
FORMS_API_URL=http://bizgpt-forms:8000
# How the user's browser reaches the forms service (embedded form)
FORMS_PUBLIC_URL=http://localhost:8090
# Which sites may embed the form (your Biz GPT origin)
FORMS_FRAME_ANCESTORS=http://localhost:3000

# ---- Biz GPT API + Dashboard ----
BIZGPT_API_PORT=8093
API_CORS_ORIGINS=http://localhost:3000,http://localhost:8093

# ---- Dify (your self-hosted server) ----
# Base URL WITHOUT /v1. Must be reachable from inside the containers.
DIFY_BASE_URL=https://dify.yourcompany.com
# Dify console as opened in the browser (dashboard "Create Workflow" link)
DIFY_CONSOLE_URL=https://dify.yourcompany.com
# One entry per Dify app. This is the dynamic source used by Biz GPT, the Dashboard API,
# and Dify-backed forms when a matching app id/name is found.
# api_key: Dify → app → "API Access" → API Key (starts with app-)
# type: chatflow | agent | chat | workflow | completion
DIFY_APPS=[{"id":"lead-qualifier","name":"Lead Qualifier","type":"workflow","api_key":"app-xxxx","input_key":"query"}]
# Optional explicit overrides. Keep these only when you want a workflow/form to use a
# dedicated env var instead of the dynamic DIFY_APPS mapping.
DIFY_WORKFLOW_LEAD_QUALIFIER_KEY=app-xxxx
DIFY_WORKFLOW_COMPANY_LEAD_GENERATION_KEY=app-bbbb
DIFY_WORKFLOW_LEAVE_REQUEST_KEY=app-yyyy
DIFY_WORKFLOW_IT_SUPPORT_KEY=app-zzzz
DIFY_WORKFLOW_PURCHASE_REQUEST_KEY=app-aaaa

# ---- Nango (self-hosted OAuth + proxy) ----
# Generate strong values:
#   openssl rand -base64 32   # NANGO_ENCRYPTION_KEY / NANGO_ADMIN_KEY
# Gmail OAuth callback for your Google app:
#   http://localhost:3003/oauth/callback
NANGO_VERSION=hosted-0.71.10
NANGO_SERVER_PORT=3003
NANGO_CONNECT_UI_PORT=3009
NANGO_SERVER_URL=http://localhost:3003
NANGO_PUBLIC_SERVER_URL=http://localhost:3003
NANGO_PUBLIC_CONNECT_URL=http://localhost:3009
NANGO_ENV=dev
NANGO_SECRET_KEY=change-me-uuid-v4
NANGO_ENCRYPTION_KEY=change-me-base64-32
NANGO_ADMIN_KEY=change-me-base64-32
NANGO_DASHBOARD_USERNAME=admin
NANGO_DASHBOARD_PASSWORD=change-me
NANGO_DB_USER=nango
NANGO_DB_PASSWORD=nango
NANGO_DB_NAME=nango
NANGO_GMAIL_CONFIG_KEY=gmail
NANGO_OUTLOOK_CONFIG_KEY=outlook
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Google Cloud Console requirements for Gmail:
# 1) Enable gmail.googleapis.com in GOOGLE_CLOUD_PROJECT_ID
# 2) Add this exact redirect URI to the OAuth client:
#    ${NANGO_PUBLIC_SERVER_URL}/oauth/callback

# ---- Biz GPT Integrations service ----
INTEGRATIONS_API_URL=http://bizgpt-integrations:8002
INTEGRATIONS_PUBLIC_URL=http://localhost:8092
INTEGRATIONS_API_KEY=change-me

# ---- Inbox Zero (self-hosted, see deploy/inbox-zero/README.md) ----
INBOX_ZERO_URL=https://test.gpt.dbizlab.com/inbox_zero
