diff --git a/apps/web/app/api/auth/[...all]/route.ts b/apps/web/app/api/auth/[...all]/route.ts
index ff9a898..36ef0c1 100644
--- a/apps/web/app/api/auth/[...all]/route.ts
+++ b/apps/web/app/api/auth/[...all]/route.ts
@@ -1,5 +1,36 @@
 import { betterAuthConfig } from "@/utils/auth";
+import { BASE_PATH } from "@/utils/base-path";
 import { toNextJsHandler } from "better-auth/next-js";
 
-export const { POST, GET, PUT, PATCH, DELETE } =
-  toNextJsHandler(betterAuthConfig);
+const handlers = toNextJsHandler(betterAuthConfig);
+
+// BizGPT patch: with a Next.js basePath (e.g. /inbox_zero), route handlers receive
+// request URLs without the prefix, while better-auth matches on the full path of its
+// baseURL (/inbox_zero/api/auth). Restore the prefix before handing the request over.
+function withBasePathRequest(handler: (request: Request) => Promise<Response>) {
+  return (request: Request) => {
+    if (!BASE_PATH) return handler(request);
+    const url = new URL(request.url);
+    if (url.pathname === BASE_PATH || url.pathname.startsWith(`${BASE_PATH}/`)) {
+      return handler(request);
+    }
+    url.pathname = `${BASE_PATH}${url.pathname}`;
+    const hasBody = request.method !== "GET" && request.method !== "HEAD";
+    return handler(
+      new Request(url, {
+        method: request.method,
+        headers: request.headers,
+        body: hasBody ? request.body : undefined,
+        signal: request.signal,
+        redirect: request.redirect,
+        ...(hasBody ? { duplex: "half" } : {}),
+      } as RequestInit),
+    );
+  };
+}
+
+export const GET = withBasePathRequest(handlers.GET);
+export const POST = withBasePathRequest(handlers.POST);
+export const PUT = withBasePathRequest(handlers.PUT);
+export const PATCH = withBasePathRequest(handlers.PATCH);
+export const DELETE = withBasePathRequest(handlers.DELETE);
