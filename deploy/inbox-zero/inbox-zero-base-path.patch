diff --git a/apps/web/app/api/bizgpt/sso/route.ts b/apps/web/app/api/bizgpt/sso/route.ts
new file mode 100644
index 0000000..cbc9cc1
--- /dev/null
+++ b/apps/web/app/api/bizgpt/sso/route.ts
@@ -0,0 +1,81 @@
+// BizGPT: single sign-on from Biz GPT (Open WebUI) into the one shared mailbox.
+// A caller with a valid Biz GPT token gets an Inbox Zero session for BIZGPT_SSO_EMAIL,
+// so the embedded inbox never shows the Google sign-in or account picker.
+import { NextResponse } from "next/server";
+import { env } from "@/env";
+import { auth, betterAuthConfig } from "@/utils/auth";
+import { SafeError } from "@/utils/error";
+import { withError } from "@/utils/middleware";
+import { buildSessionCookie } from "@/utils/mobile-review";
+import prisma from "@/utils/prisma";
+
+const ALLOWED_ROLES = new Set(["user", "admin"]);
+
+export const POST = withError("bizgpt/sso", async (request) => {
+  const email = env.BIZGPT_SSO_EMAIL;
+  if (!email || !env.BIZGPT_AUTH_URL) {
+    throw new SafeError("Biz GPT sign-in is not configured", 404);
+  }
+
+  const bizGptUser = await getBizGptUser(request);
+  if (!bizGptUser) throw new SafeError("Sign in to Biz GPT first", 401);
+
+  const emailAccount = await prisma.emailAccount.findUnique({
+    where: { email },
+    select: { id: true, userId: true },
+  });
+  if (!emailAccount) {
+    request.logger.warn("Biz GPT SSO mailbox is not connected", { email });
+    throw new SafeError("Biz Inbox mailbox is not connected", 503);
+  }
+
+  const response = NextResponse.json({ emailAccountId: emailAccount.id, email });
+  response.headers.set("Cache-Control", "no-store");
+
+  // Reuse the current session when it already belongs to the mailbox owner.
+  const current = await auth(request.headers).catch(() => null);
+  if (current?.user.id === emailAccount.userId) return response;
+
+  const authContext = await betterAuthConfig.$context;
+  const session = await authContext.internalAdapter.createSession(
+    emailAccount.userId,
+    false,
+    {},
+  );
+  const cookie = await buildSessionCookie({
+    authContext,
+    expiresAt: session.expiresAt,
+    sessionToken: session.token,
+  });
+  response.cookies.set(cookie.name, cookie.value, cookie.options);
+
+  request.logger.info("Created Biz GPT SSO session", {
+    bizGptUserId: bizGptUser.id,
+    emailAccountId: emailAccount.id,
+  });
+
+  return response;
+});
+
+async function getBizGptUser(request: Request) {
+  const bearer = request.headers.get("authorization")?.match(/^Bearer\s+(.+)$/i)?.[1];
+  const cookieToken = request.headers
+    .get("cookie")
+    ?.match(/(?:^|;\s*)token=([^;]+)/)?.[1];
+  const token = bearer || cookieToken;
+  if (!token) return null;
+
+  const res = await fetch(env.BIZGPT_AUTH_URL!, {
+    headers: { Authorization: `Bearer ${token}` },
+    cache: "no-store",
+    signal: AbortSignal.timeout(5000),
+  }).catch(() => null);
+  if (!res?.ok) return null;
+
+  const user = (await res.json().catch(() => null)) as {
+    id?: string;
+    role?: string;
+  } | null;
+  if (!user?.id || !ALLOWED_ROLES.has(user.role ?? "")) return null;
+  return { id: user.id };
+}
