# ---- Meta WhatsApp Cloud API (developers.facebook.com → your app → WhatsApp → API Setup) ----
# Permanent System User token with whatsapp_business_messaging + whatsapp_business_management.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Any long random string; paste the same value into Meta → WhatsApp → Configuration → Verify token.
WHATSAPP_VERIFY_TOKEN=
# App → Settings → Basic → App secret. Used to verify X-Hub-Signature-256 on every webhook.
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v23.0

# ---- Biz GPT (Open WebUI) ----
# Server-side URL of Biz GPT. From Docker on the same host: http://host.docker.internal:3000
OPENWEBUI_BASE_URL=http://host.docker.internal:3000
# API key of a dedicated Biz GPT service user (Settings → Account → API Keys). WhatsApp chats are saved under this user.
OPENWEBUI_API_KEY=
# Workspace model that answers customers (owui/models/bizgpt-whatsapp.json)
WHATSAPP_AGENT_MODEL=bizgpt-whatsapp
OPENWEBUI_MIRROR_CHATS=true

# ---- This service ----
# Bearer key for the internal API used by the Biz GPT tool and Integrations page: openssl rand -hex 32
WHATSAPP_SERVICE_API_KEY=
DATABASE_URL=postgresql+asyncpg://whatsapp:whatsapp@whatsapp-db:5432/whatsapp
WHATSAPP_PORT=8104
AUTO_REPLY_ENABLED=true
CONVERSATION_TIMEOUT_HOURS=24
HISTORY_MESSAGES=20
RATE_LIMIT_PER_MINUTE=10
LOG_LEVEL=INFO
